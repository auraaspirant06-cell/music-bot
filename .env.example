# ==============================================================================
# Telegram Group & Voice Chat Music Bot Configuration
# Copy this file to .env and fill in your credentials before running:
#   cp .env.example .env
# ==============================================================================

# Telegram API credentials from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_32_char_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAF_your_bot_token_here

# Assistant user account Pyrogram/Kurigram session string
# Generate on your VPS with: python music_bot.py --generate-session
SESSION_STRING=

# ------------------------------------------------------------------------------
# Direct YouTube Data API v3 Integration (Prevents VPS Search/Autoplay Blocks!)
# Get a free API key at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=
# Optional: comma-separated backup API keys for automatic daily quota rotation
YOUTUBE_API_KEYS=
# Optional: ISO 3166-1 alpha-2 country code for search results (e.g. US, IN, GB)
YOUTUBE_REGION_CODE=

# ------------------------------------------------------------------------------
# Anti-VPS-IP-Block Audio Stream Protection
# ------------------------------------------------------------------------------
# Optional external audio stream API / Piped / Invidious relay URL
# Examples:
#   https://your-relay.workers.dev/audio?id={video_id}
#   https://your-piped-api.example.com/streams/{video_id}
#   https://your-invidious.example.com/api/v1/videos/{video_id}
STREAM_API_URL=
STREAM_API_KEY=

# Optional PO Token HTTP sidecar (e.g. http://127.0.0.1:4416 or http://bgutil-provider:4416)
PO_TOKEN_SERVER=
# Optional manual PO Token / Visitor Data (advanced)
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Comma-separated YouTube extractor client rotation order on bot-check errors
YOUTUBE_PLAYER_CLIENTS=default,tv,android_vr,web_safari

# Optional proxy ONLY for yt-dlp audio extraction (e.g. Cloudflare WARP socks5://127.0.0.1:40000)
PROXY_URL=

# Bind yt-dlp outgoing IP family: 0.0.0.0 (IPv4), :: (IPv6), or empty for OS default
YTDLP_SOURCE_ADDRESS=0.0.0.0

# Optional: path to Netscape cookies.txt from a secondary Google account
COOKIES_FILE=

# Fallback to SoundCloud when YouTube blocks audio extraction for text queries (true/false)
ALT_SOURCE_FALLBACK=true

# ------------------------------------------------------------------------------
# Audio Quality, Playback & Caching
# ------------------------------------------------------------------------------
# Audio quality preset: STUDIO (96kHz stereo), HIGH (48kHz stereo), MEDIUM, LOW
AUDIO_QUALITY=STUDIO

# Playback mode:
#   hybrid = instant direct start on idle + SSD pre-fetch for queued/autoplay (recommended)
#   cache  = always download into audio_cache before playing (auto-used when PROXY_URL is set)
#   direct = stream extracted URLs directly without disk cache
STREAM_MODE=hybrid

# Smooth non-stop autoplay when queue finishes (true/false)
AUTOPLAY_DEFAULT=true

# Pre-download next queued/autoplay track while current song plays (true/false)
PREFETCH_ENABLED=true

# Restrict skip/pause/stop/loop/shuffle/volume to group admins & track requester
ADMIN_ONLY_CONTROLS=false

# Queue, playlist, duration, and disk cache bounds
MAX_QUEUE_SIZE=50
MAX_PLAYLIST_IMPORT=20
MAX_TRACK_DURATION_SECONDS=7200
CACHE_DIR=./audio_cache
MAX_CACHE_FILES=30
SEARCH_CACHE_TTL_SECONDS=900

# Auto-leave idle voice chat after N seconds when queue & autoplay are idle (0 = stay)
IDLE_LEAVE_SECONDS=180

# Optional: extra FFmpeg audio filter, e.g. loudnorm=I=-14:TP=-1.5:LRA=11
FFMPEG_AUDIO_FILTER=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
